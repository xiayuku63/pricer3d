# ── Environment ──
# development | production
APP_ENV=development

# ── Secrets ──
# 生产环境必须为每个实例生成独立随机密钥
JWT_SECRET_KEY=dev-key-change-in-production
PAYMENT_WEBHOOK_SECRET=dev-webhook-change-in-production

# ── Database ──
# SQLite 文件路径（Docker 中自动设为 /app/data/app.db）
DB_PATH=app.db

# ── Email (至少配置一个) ──
# 方式 1: Resend API (推荐，简单)
#   注册 https://resend.com → 获取 API Key → 验证发件域名
# RESEND_API_KEY=re_xxxxxxxxxxxx

# 方式 2: 自建 SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false

# ── Dev ──
# 开发环境设为 true，验证码会在接口响应中返回 dev_code
SHOW_DEV_CODES=true
# 开发便捷后门：设为 1 后可用 /api/auth/admin-login（admin/admin123）快速登录。
# 默认关闭（fail-closed），生产环境无论怎么设置都不可用。
ENABLE_DEV_ADMIN_LOGIN=0

# ── Proxy ──
# 部署在反向代理（nginx）后面时保持 true，客户端 IP 从 X-Real-IP / X-Forwarded-For 解析。
# 应用端口直接对外暴露时必须设为 false，否则攻击者可伪造转发头绕过 IP 限速。
TRUST_PROXY=true

# ── Payment ──
PAYMENT_PROVIDER=mock

# ── Directories ──
UPLOADS_DIR=uploads
OUTPUTS_DIR=outputs
USER_DATA_DIR=user

# ── Logging ──
LOG_LEVEL=DEBUG

# ── PrusaSlicer ──
# 可选，指定 PrusaSlicer 可执行文件路径。不设置时自动检测。
# Docker 中会自动安装 v2.9.6，无需设置。
# PRUSA_EXECUTABLE=

# ── 切片缓存（G-code slice cache）──
PRUSA_SLICE_CACHE=1
# 缓存目录默认 data/slicer_cache（Docker 中为 /app/data/slicer_cache）
# PRUSA_SLICE_CACHE_DIR=
PRUSA_SLICE_CACHE_MAX_MB=1024
PRUSA_SLICE_CACHE_MAX_AGE_DAYS=30

# ── 切片与朝向 ──
# 切片超时 = 基础值 + 每MB追加秒数（上限封顶），大模型不再 120s 一刀切
# PRUSA_SLICE_TIMEOUT=120
# PRUSA_SLICE_TIMEOUT_PER_MB=2
# PRUSA_SLICE_TIMEOUT_MAX=900
# 朝向分析结果缓存（按模型内容寻址），重复报价跳过数秒的几何分析
# ORIENTATION_CACHE=1
# ORIENTATION_CACHE_MAX_MB=512
# ZIP 批量报价并发数（AppImage 已预解压，不再有全局切片锁）
# ZIP_QUOTE_CONCURRENCY=3

# ── CORS ──
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:3000,http://127.0.0.1:3000

# ── Legal ──
TERMS_VERSION=v2
PRIVACY_VERSION=v2
LEGAL_EFFECTIVE_DATE=2026-07-31
LEGAL_OPERATOR_NAME=Pricer3D 运营方
LEGAL_CONTACT_EMAIL=
LEGAL_CONTACT_ADDRESS=
